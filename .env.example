# Copia questo file in ".env" (non viene caricato su Git) solo se vuoi
# cambiare qualcosa. Senza ".env" valgono questi stessi valori di default.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=turnogiusto
MYSQL_USER=turnogiusto
MYSQL_PASSWORD=turnogiusto
# Cambia la porta se sul tuo PC c'e' gia' un MySQL sulla 3306 (es. 3307).
MYSQL_PORT=3306
